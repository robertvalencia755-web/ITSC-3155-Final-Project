{
  "name": "courselens-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "CourseLens backend",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
